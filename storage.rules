rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /pdfs/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.resource == null ||
        (request.resource.size <= 300 * 1024 * 1024 &&
          request.resource.contentType == 'application/pdf');
    }

    match /{allPaths=**} {
      allow read, write: if allPaths.split('/')[0] != 'pdfs';
    }
  }
}
